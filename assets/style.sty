% ================= MACRO CÂU HỎI =================
\newcommand{\cau}[1]{%
    \stepcounter{cau}%
    \par\vspace{8pt}\noindent
    \setbox0=\hbox{\textbf{\textcolor{navy}{Câu \thecau.\ }}}%
    \hangindent=\wd0 \hangafter=1
    \usebox0\textcolor{black}{#1}\par
}

% ================= MACRO VẼ HÌNH TRÒN ĐÁP ÁN =================
\newcommand{\optbox}[2]{%
    \def\cur{#1}\def\ans{#2}%
    \ifx\cur\ans
        \tikz[baseline=(char.base)] \node[shape=circle, draw=teal, thick, fill=teal, text=white, minimum size=1.35em, inner sep=0pt, font=\bfseries] (char) {#1};%
    \else
        \tikz[baseline=(char.base)] \node[shape=circle, draw=navy, thick, fill=white, text=navy, minimum size=1.2em, inner sep=0pt, font=\bfseries] (char) {#1};%
    \fi
}

% ================= MACRO PHƯƠNG ÁN (6 THAM SỐ) =================
% #1, #2, #3, #4: Nội dung 4 phương án
% #5: Số cột (1, 2, hoặc 4)
% #6: Đáp án đúng (A, B, C, D). Để trống {} thì không tô màu.
\newcommand{\phuongan}[6]{%
    \par\vspace{6pt}\noindent%
    \def\tempA{#1}\def\tempB{#2}\def\tempC{#3}\def\tempD{#4}%
    %
    \ifnum#5=1
        % --- CHẾ ĐỘ 1 DÒNG ---
        \begin{tabular}{@{}*{4}{p{\dimexpr(\linewidth-6\tabcolsep)/4\relax}}@{}}
            \ifx\tempA\empty\else\optbox{A}{#6}~#1\fi & 
            \ifx\tempB\empty\else\optbox{B}{#6}~#2\fi & 
            \ifx\tempC\empty\else\optbox{C}{#6}~#3\fi & 
            \ifx\tempD\empty\else\optbox{D}{#6}~#4\fi
        \end{tabular}%
    \else\ifnum#5=2
        % --- CHẾ ĐỘ 2 DÒNG ---
        \def\hanghai{}% 
        \ifx\tempC\empty
            \ifx\tempD\empty
            \else
                \def\hanghai{\\[0.3cm] & \optbox{D}{#6}~#4}%
            \fi
        \else
            \ifx\tempD\empty
                \def\hanghai{\\[0.3cm] \optbox{C}{#6}~#3 & }%
            \else
                \def\hanghai{\\[0.3cm] \optbox{C}{#6}~#3 & \optbox{D}{#6}~#4}%
            \fi
        \fi
        \begin{tabular}{@{}*{2}{p{\dimexpr(\linewidth-2\tabcolsep)/2\relax}}@{}}
            \ifx\tempA\empty\else\optbox{A}{#6}~#1\fi & \ifx\tempB\empty\else\optbox{B}{#6}~#2\fi \hanghai
        \end{tabular}%
    \else\ifnum#5=4
        % --- CHẾ ĐỘ 4 DÒNG ---
        \def\hangB{}\def\hangC{}\def\hangD{}%
        \ifx\tempB\empty\else\def\hangB{\\[0.3cm] \optbox{B}{#6}~#2}\fi
        \ifx\tempC\empty\else\def\hangC{\\[0.3cm] \optbox{C}{#6}~#3}\fi
        \ifx\tempD\empty\else\def\hangD{\\[0.3cm] \optbox{D}{#6}~#4}\fi
        \begin{tabular}{@{}p{\linewidth}@{}}
            \ifx\tempA\empty\else\optbox{A}{#6}~#1\fi \hangB \hangC \hangD
        \end{tabular}%
    \fi\fi\fi
    \vspace{3pt}%
}

% ================= MACRO DẤU TÍCH =================
\newcommand{\dautich}{%
    \tikz[baseline=-0.6ex, scale=0.75]{ 
        \fill[teal, rounded corners=1pt]
        (0.1, 0.4) -- (0.35, 0.15) -- (0.8, 0.7) -- (0.95, 0.55) -- (0.35, -0.2) -- (-0.05, 0.25) -- cycle; 
    }%
}

% ================= MACRO BẢNG ĐÚNG/SAI (8 THAM SỐ) =================
\newcommand{\bangdungsai}[8]{%
    \par\vspace{6pt}\noindent
    \begingroup 
    \def\ansA{#5}\def\ansB{#6}\def\ansC{#7}\def\ansD{#8}%
    \def\valD{Đ}\def\valS{S}%
    
    \arrayrulecolor{navy}% Đổi màu viền bảng
    \renewcommand{\arraystretch}{1.6}% 
    \setlength{\arrayrulewidth}{1pt}% 
    
    \noindent\makebox[\linewidth][c]{%
        \begin{tabularx}{\linewidth}{@{} >{\centering\arraybackslash}p{1cm} | X | >{\centering\arraybackslash}p{1.2cm} | >{\centering\arraybackslash}p{1.2cm} @{}}
            & \centering\textbf{\textcolor{navy}{Mệnh đề}} & \textbf{\textcolor{navy}{Đúng}} & \textbf{\textcolor{navy}{Sai}} \\
            \hline
            \textbf{\textcolor{navy}{(a)}} & \textcolor{black}{#1} & \ifx\ansA\valD\dautich\fi & \ifx\ansA\valS\dautich\fi \\
            \hline
            \textbf{\textcolor{navy}{(b)}} & \textcolor{black}{#2} & \ifx\ansB\valD\dautich\fi & \ifx\ansB\valS\dautich\fi \\
            \hline
            \textbf{\textcolor{navy}{(c)}} & \textcolor{black}{#3} & \ifx\ansC\valD\dautich\fi & \ifx\ansC\valS\dautich\fi \\
            \hline
            \textbf{\textcolor{navy}{(d)}} & \textcolor{black}{#4} & \ifx\ansD\valD\dautich\fi & \ifx\ansD\valS\dautich\fi \\
        \end{tabularx}%
    }%
    \par
    \endgroup
    \arrayrulecolor{black}% 
    \par\vspace{10pt}%
}

% ================= MACRO ĐIỀN ĐÁP ÁN TRẢ LỜI NGẮN (4 THAM SỐ) =================
\newcommand{\traloi}[4]{%
    \par\vspace{5pt}
    \hfill 
    \setlength{\arrayrulewidth}{1pt}
    \begin{tikzpicture}
        \node[draw=navy, thick, minimum height=0.8cm, text=navy, font=\bfseries, inner sep=5pt, anchor=east] at (0,0) {Trả lời};
        
        \draw[navy, thick] (0.0, -0.4) rectangle (1.2, 0.4);
        \draw[navy, thick] (1.2, -0.4) rectangle (2.4, 0.4);
        \draw[navy, thick] (2.4, -0.4) rectangle (3.6, 0.4);
        \draw[navy, thick] (3.6, -0.4) rectangle (4.8, 0.4);
        
        \def\ansA{#1}
        \ifx\ansA\empty\else \node[text=black, font=\large\bfseries] at (0.6, 0) {#1}; \fi
        
        \def\ansB{#2}
        \ifx\ansB\empty\else \node[text=black, font=\large\bfseries] at (1.8, 0) {#2}; \fi
        
        \def\ansC{#3}
        \ifx\ansC\empty\else \node[text=black, font=\large\bfseries] at (3.0, 0) {#3}; \fi
        
        \def\ansD{#4}
        \ifx\ansD\empty\else \node[text=black, font=\large\bfseries] at (4.2, 0) {#4}; \fi
    \end{tikzpicture}\par\vspace{10pt}
}


